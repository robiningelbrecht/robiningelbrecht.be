<!doctype html>
<html class="scroll-smooth" lang="en">
<head>
    <!-- metas -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Developer | Robin Ingelbrecht</title>

    <!-- HTML Meta Tags -->
    <meta name="description"
          content="Dad | PHP developer | Open source enthusiast | Amateur cyclist">
    <meta name="author" content="Robin Ingelbrecht | Developer">
    <meta name="designer" content="Robin Ingelbrecht | Developer">
    <meta name="publisher" content="Robin Ingelbrecht | Developer">

    <!-- Google / Search Engine Tags -->
    <meta itemprop="name" content="Robin Ingelbrecht | Developer">
    <meta itemprop="description"
          content="Dad | PHP developer | Open source enthusiast | Amateur cyclist">
    <meta itemprop="image" content="http://robiningelbrecht.be/assets/logo.png">

    <!-- Facebook Meta Tags -->
    <meta property="og:url" content="https://robiningelbrecht.be">
    <meta property="og:type" content="website">
    <meta property="og:title" content="Robin Ingelbrecht | Developer">
    <meta property="og:description"
          content="Dad | PHP developer | Open source enthusiast | Amateur cyclist">
    <meta property="og:image" content="http://robiningelbrecht.be/assets/logo.png">

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Robin Ingelbrecht | Developer">
    <meta name="twitter:description"
          content="Dad | PHP developer | Open source enthusiast | Amateur cyclist">
    <meta name="twitter:image" content="http://robiningelbrecht.be/assets/logo.png">

    <link href="assets/favicon.png" rel="icon" type="image/png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="css/style.min.css">
</head>

<body class="bg-white text-zinc-900 font-sans text-[15px]/[1.6] antialiased">
<div class="max-w-[1180px] mx-auto px-8 lg:grid lg:grid-cols-[340px_1fr] lg:gap-18">
    <aside class="flex flex-col pt-18 lg:sticky lg:top-0 lg:h-screen lg:pb-18">
        <img class="w-22 h-22 rounded-full mb-6" src="assets/logo.png" alt="Robin Ingelbrecht">
        <h1 class="font-display text-[34px] font-semibold tracking-[-0.02em] leading-[1.15]">Robin Ingelbrecht</h1>
        <p class="text-[13px] font-medium text-zinc-700 mt-1.5 mb-4">Dad | PHP developer | Open source enthusiast | Amateur cyclist</p>
        <p class="text-zinc-500">I'm a PHP developer from Bruges, Belgium. I maintain a handful of open source projects. Outside of work I'm a dad and an amateur cyclist.</p>
        <p class="flex items-center gap-1.5 text-[13px] text-zinc-400 mt-4">
            <svg class="size-3" fill="currentColor" viewBox="0 0 16 16"><path d="M8 0C5.24 0 3 2.24 3 5c0 4.25 5 10 5 10s5-5.75 5-10c0-2.76-2.24-5-5-5zm0 7a2 2 0 110-4 2 2 0 010 4z"/></svg>
            Bruges, Belgium
        </p>
        <nav class="hidden lg:flex flex-col gap-2.5 mt-10">
            {% for anchor, label in {'blog': 'Writing', 'projects': 'Projects'} %}
                <a href="#{{ anchor }}" class="group flex items-center gap-3 text-[13px] font-semibold uppercase tracking-[0.08em] text-zinc-400 hover:text-zinc-900">
                    <span class="w-7 h-px bg-current transition-[width] duration-150 group-hover:w-12"></span>{{ label }}
                </a>
            {% endfor %}
        </nav>
        <div class="flex items-center gap-4 mt-7 lg:mt-auto">
            <a href="https://github.com/robiningelbrecht" title="GitHub" target="_blank" class="text-zinc-400 hover:text-zinc-900">
                <svg class="size-5" fill="currentColor" viewBox="0 0 20 20"><path d="M10 0C4.477 0 0 4.477 0 10c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.154-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0110 4.836c.85.004 1.705.114 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C17.137 18.163 20 14.418 20 10c0-5.523-4.477-10-10-10z"/></svg>
            </a>
            <a href="https://www.linkedin.com/in/robin-ingelbrecht/" title="LinkedIn" target="_blank" class="text-zinc-400 hover:text-zinc-900">
                <svg class="size-5" fill="currentColor" viewBox="0 0 32 32"><path d="M28.778 1.004h-25.56c-1.199 0-2.172.964-2.186 2.159v25.672c.014 1.196.987 2.161 2.186 2.161h25.555c1.2 0 2.175-.963 2.194-2.159v-25.67c-.019-1.197-.994-2.161-2.195-2.161zm-18.878 25.558h-4.454v-14.311h4.454v14.311zm-2.226-16.269c-1.425 0-2.579-1.155-2.579-2.579s1.155-2.579 2.579-2.579 2.579 1.154 2.579 2.578c0 1.423-1.154 2.577-2.577 2.577zm19.082 16.269h-4.441v-6.959c0-1.66-.034-3.795-2.314-3.795-2.316 0-2.669 1.806-2.669 3.673v7.082h-4.441v-14.311h4.266v1.951h.058c.828-1.395 2.326-2.315 4.039-2.315 4.5 0 5.332 2.962 5.332 6.817v7.855z"/></svg>
            </a>
            <a href="https://ingelbrechtrobin.medium.com/" title="Medium" target="_blank" class="text-zinc-400 hover:text-zinc-900">
                <svg class="size-5" fill="currentColor" viewBox="0 0 24 24"><path d="M13 12C13 15.31 10.31 18 7 18C3.69 18 1 15.31 1 12C1 8.69 3.69 6 7 6C10.31 6 13 8.69 13 12ZM23 12C23 14.76 22.55 17 22 17C21.45 17 21 14.76 21 12C21 9.24 21.45 7 22 7C22.55 7 23 9.24 23 12ZM17 18C18.66 18 20 15.31 20 12C20 8.69 18.66 6 17 6C15.34 6 14 8.69 14 12C14 15.31 15.34 18 17 18Z"/></svg>
            </a>
            <a href="https://resume.robiningelbrecht.be/" target="_blank" class="flex items-center gap-1.5 text-sm font-medium border border-zinc-200 rounded-md px-3 py-1.5 hover:border-zinc-400">
                Resume
                <svg class="size-[11px]" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 12 12"><path d="M3.5 8.5l5-5M4 3.5h4.5V8"/></svg>
            </a>
        </div>
    </aside>
    <main class="py-18">
        <section id="blog" class="mb-20">
            <h2 class="font-display text-2xl font-semibold tracking-[-0.01em] mb-5">Recent writing</h2>
            {% for blogPost in blogPosts %}
                <a href="{{ blogPost.getLink() }}" target="_blank" class="grid sm:grid-cols-[150px_1fr] gap-5 p-4 -mx-4 rounded-[10px] transition-colors duration-150 hover:bg-zinc-100">
                    <img class="w-full h-40 sm:h-[90px] object-cover rounded-md border border-zinc-200" src="{{ blogPost.getImage() }}" alt="{{ blogPost.getTitle()|raw }}" loading="lazy">
                    <div>
                        <time class="font-mono text-xs text-zinc-400">{{ blogPost.getPubDate().format('M d, Y') }}</time>
                        <h3 class="text-base font-semibold leading-[1.4] mt-1">{{ blogPost.getTitle()|raw }}</h3>
                    </div>
                </a>
            {% endfor %}
        </section>
        <section id="projects">
            <h2 class="font-display text-2xl font-semibold tracking-[-0.01em] mb-5">Open source</h2>
            <div class="grid lg:grid-cols-2 gap-3">
                {% for repo in repos %}
                    <a href="{{ repo.url }}" target="_blank" class="flex gap-3.5 p-[18px] border border-zinc-200 rounded-[10px] transition-colors duration-150 hover:border-zinc-400">
                        <img class="size-10 shrink-0 rounded-lg object-cover bg-zinc-100" src="{{ repo.image }}" alt="{{ repo.name }}" loading="lazy">
                        <div class="min-w-0">
                            <h3 class="font-mono text-sm font-semibold break-words">{{ repo.name }}</h3>
                            <p class="text-[13px] text-zinc-500 mt-1">{{ repo.description }}</p>
                            <span class="inline-flex items-center gap-1 text-xs text-zinc-500 mt-2">
                                <svg class="size-[11px] text-star" fill="currentColor" viewBox="0 0 16 16"><path d="M8 .25a.75.75 0 01.673.418l1.882 3.815 4.21.612a.75.75 0 01.416 1.279l-3.046 2.97.719 4.192a.75.75 0 01-1.088.791L8 12.347l-3.766 1.98a.75.75 0 01-1.088-.79l.72-4.194L.818 6.374a.75.75 0 01.416-1.28l4.21-.611L7.327.668A.75.75 0 018 .25z"/></svg>
                                {{ repo.stars|number_format }}
                            </span>
                        </div>
                    </a>
                {% endfor %}
            </div>
        </section>
    </main>
</div>
</body>
</html>
